PORT=5000
NODE_ENV=development

# Use DATABASE_URL in production when your host gives you one.
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/hr_operations
DATABASE_URL=

# Local/development database settings. These are used when DATABASE_URL is empty.
DB_HOST=127.0.0.1
DB_PORT=55432
DB_NAME=hr_operations
DB_USER=postgres
DB_PASSWORD=
DB_SSL=false

JWT_SECRET=replace-this-with-a-long-random-secret
JWT_EXPIRES_IN=8h
# Required once to create the first administrator through POST /api/v1/auth/bootstrap.
# Store it securely and rotate/remove it after bootstrapping.
INITIAL_ADMIN_TOKEN=replace-with-a-long-random-bootstrap-token
BCRYPT_ROUNDS=10

# Google Sign-In. Use the Web application OAuth client ID from Google Cloud.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_IDS=
GOOGLE_AUTO_CREATE_ACCOUNTS=true

# Comma-separated origins or * for local development.
CORS_ORIGIN=*

# Set false only for local API exploration without tokens.
AUTH_REQUIRED=true

UPLOAD_DIR=uploads
