Project hr_operations_management {
  database_type: 'PostgreSQL'
  Note: 'HR and Operations Management System schema generated from the normalized table document.'
}

Table org.employee {
  employee_id int [pk, increment, note: 'Auto-increment surrogate key']
  f_name varchar(50) [not null, note: 'First name']
  l_name varchar(50) [not null, note: 'Last name']
  email varchar(100) [not null, unique, note: 'Work email address']
  gender varchar(10) [note: 'Male / Female / Other']
  birth_date date [note: 'Date of birth']
  national_id varchar(30) [unique, note: 'Ethiopian national ID number']
  nationality varchar(60)
  hire_date date [not null, note: 'Employment start date']
  employment_status varchar(20) [not null, note: 'Active / Suspended / Resigned / Terminated']
  terminated_date date [note: 'Populated on exit']
  dept_id int [note: 'References Departments(dept_id)']
  job_id int [note: 'References Job_titles(job_id)']
  office_id int [note: 'References Offices(office_id)']
  manager_id int [note: 'Self-reference -> Employee(employee_id)']
  is_deleted boolean [default: `false`, note: 'Soft-delete flag']
  deleted_at timestamptz [note: 'Timestamp of logical deletion']
  created_at timestamptz [default: `now()`]
  updated_at timestamptz
}

Table org.departments {
  dept_id int [pk, increment]
  dept_name varchar(100) [not null, note: 'e.g. Finance, Engineering, HR']
  office_id int [note: 'References Offices(office_id)']
}

Table org.offices {
  office_id int [pk, increment]
  location_name varchar(100) [not null, note: 'Office location name']
  city varchar(100)
  addresses text [note: 'Full postal address']
}

Table org.shifts {
  shift_id int [pk, increment]
  shift_name varchar(100) [not null, note: 'e.g. Morning, Evening, Night']
  start_time time [not null, note: 'Shift start time']
  end_time time [not null, note: 'Shift end time']
  department_id int [note: 'References Departments(dept_id)']
}

Table org.emergency_contacts {
  contact_id int [pk, increment]
  employee_id int [note: 'References Employee(employee_id)']
  name varchar(100) [not null, note: 'Full name of contact person']
  phone varchar(20) [not null, note: 'Contact phone number']
}

Table org.dependants {
  dependant_id int [pk, increment]
  employee_id int [note: 'References Employee(employee_id)']
  f_name varchar(50) [not null, note: 'First name']
  l_name varchar(50) [not null, note: 'Last name']
  relationship varchar(50) [not null, note: 'Spouse / Child / Parent / Sibling']
}

Table org.attendance {
  attendance_id int [pk, increment]
  employee_id int [note: 'References Employee(employee_id)']
  date date [not null, note: 'Attendance date']
  status varchar(20) [not null, note: 'Present / Absent / Late / Leave']
  check_in time [note: 'Clock-in time']
  check_out time [note: 'Clock-out time']
  total_hours decimal(5,2) [note: 'Computed hours - see 3NF deviation note in Chapter 3']
  location_type varchar(20) [note: 'On_site / Remote']
  created_at timestamptz [default: `now()`]
  updated_at timestamptz
}

Table org.overtime_records {
  overtime_id int [pk, increment]
  employee_id int [note: 'References Employee(employee_id)']
  date date [not null, note: 'Date overtime was worked']
  hours_worked decimal(5,2) [not null, note: 'Extra hours worked beyond shift']
  approved_by int [note: 'References Employee(employee_id)']
  payment_status varchar(20) [note: 'Pending / Paid / Carried']
  created_at timestamptz [default: `now()`]
  updated_at timestamptz
}

Table org.onboarding_checklists {
  checklist_id int [pk, increment]
  employee_id int [note: 'References Employee(employee_id)']
  created_by int [note: 'References Employee(employee_id) - HR officer']
  status varchar(20) [not null, note: 'In_Progress / Completed']
  created_at timestamptz [default: `now()`]
  updated_at timestamptz
}

Table org.onboarding_tasks {
  task_id int [pk, increment]
  checklist_id int [note: 'References Onboarding_checklists(checklist_id)']
  task_name varchar(200) [not null, note: 'e.g. Submit national ID, Setup email']
  due_date date
  completed_by int [note: 'References Employee(employee_id)']
  status varchar(20) [not null, note: 'Pending / Done / Overdue']
  created_at timestamptz [default: `now()`]
  updated_at timestamptz
}

Table org.employee_exits {
  exit_id int [pk, increment]
  employee_id int [note: 'References Employee(employee_id)']
  exit_type varchar(30) [not null, note: 'Resignation / Termination / Retirement']
  last_working_day date [not null]
  reason text
  clearance_status varchar(20) [not null, note: 'Pending / Cleared / Incomplete']
  created_at timestamptz [default: `now()`]
  updated_at timestamptz
}

Table org.grievances {
  grievance_id int [pk, increment]
  employee_id int [note: 'References Employee(employee_id) - complainant']
  submitted_date date [not null]
  category varchar(100) [note: 'Harassment / Salary / Safety / Other']
  description text [not null]
  status varchar(20) [not null, note: 'Open / In_Review / Resolved / Closed']
  resolved_by int [note: 'References Employee(employee_id) - HR officer']
  resolution_date date
  resolution_notes text
  created_at timestamptz [default: `now()`]
  updated_at timestamptz
}

Table org.disciplinary_actions {
  action_id int [pk, increment]
  employee_id int [note: 'References Employee(employee_id)']
  action_type varchar(50) [not null, note: 'Verbal_Warning / Written_Warning / Suspension / Dismissal']
  reason text [not null, note: 'Grounds for the action']
  action_date date [not null]
  issued_by int [note: 'References Employee(employee_id) - manager / HR']
  appeal_status varchar(20) [note: 'None / Pending / Upheld / Overturned']
  created_at timestamptz [default: `now()`]
  updated_at timestamptz
}

Table org.assets {
  asset_id int [pk, increment]
  asset_name varchar(200) [not null, note: 'e.g. Dell Laptop XPS 15']
  asset_type varchar(100) [not null, note: 'Laptop / Vehicle / Phone / ID_Card']
  serial_number varchar(100) [unique, note: 'Manufacturer serial number']
  purchase_date date
  condition varchar(30) [note: 'New / Good / Fair / Damaged']
  status varchar(20) [not null, note: 'Available / Assigned / Retired']
  is_deleted boolean [default: `false`, note: 'Soft-delete flag']
  deleted_at timestamptz
}

Table org.asset_assignments {
  assignment_id int [pk, increment]
  asset_id int [note: 'References Assets(asset_id)']
  employee_id int [note: 'References Employee(employee_id)']
  assigned_date date [not null]
  returned_date date [note: 'NULL = asset still assigned']
  condition_on_return varchar(30) [note: 'Condition when asset was returned']
  created_at timestamptz [default: `now()`]
  updated_at timestamptz
}

Table org.employee_shifts {
  employee_id int [note: 'References Employee(employee_id)']
  shift_id int [note: 'References Shifts(shift_id) - composite PK']
  assigned_date date [not null, note: 'Date the shift assignment starts']
  end_date date [note: 'NULL = ongoing assignment']

  indexes {
    (employee_id, shift_id) [pk]
  }
}

Table org.employee_phones {
  phone_id int [pk, increment]
  employee_id int [note: 'References Employee(employee_id)']
  phone_type varchar(30) [not null, note: 'Mobile / Work / Home / Other']
  phone_number varchar(20) [not null]
  is_primary boolean [default: `false`, note: 'Primary contact number flag']
}

Table org.employee_addresses {
  address_id int [pk, increment]
  employee_id int [note: 'References Employee(employee_id)']
  address_type varchar(30) [not null, note: 'Home / Work / P.O.Box / Other']
  address_line text [not null, note: 'Full address text']
  city varchar(100)
  is_primary boolean [default: `false`, note: 'Primary mailing address flag']
}

Table people.promotions {
  promotion_id int [pk, increment]
  employee_id int [note: 'References Employee(employee_id)']
  old_job_id int [note: 'References Job_titles(job_id) - previous role']
  new_job_id int [note: 'References Job_titles(job_id) - promoted role']
  old_matrix_id int [note: 'References Salary_matrix(matrix_id) - previous salary']
  new_matrix_id int [note: 'References Salary_matrix(matrix_id) - new salary']
  promotion_type varchar(50) [not null, note: 'Vertical / Horizontal / Acting']
  effective_date date [not null, note: 'Date promotion takes effect']
  status varchar(20) [not null, note: 'Pending / Approved / Rejected']
  created_at timestamptz [default: `now()`]
  updated_at timestamptz
}

Table people.promotion_criteria_assessment {
  assessment_id int [pk, increment]
  promotion_id int [note: 'References Promotions(promotion_id)']
  performance_review decimal(5,2) [note: 'Performance review score used in assessment']
  training_completed boolean [default: `false`, note: 'Required training completed-']
  attendance_score decimal(5,2) [note: 'Attendance record score']
  yrs_in_role decimal(4,1) [note: 'Years spent in current role']
  disciplinary_7 boolean [default: `false`, note: 'Any disciplinary action in last 7 months-']
  overall_score decimal(5,2) [note: 'Composite assessment score']
  assessment_date date [not null]
  assessed_by int [note: 'References Employee(employee_id) - HR officer']
  created_at timestamptz [default: `now()`]
}

Table people.promotionapproval_log {
  log_id int [pk, increment]
  promotion_id int [note: 'References Promotions(promotion_id)']
  approver_id int [note: 'References Employee(employee_id)']
  action varchar(20) [not null, note: 'Approved / Rejected / Returned']
  notes text [note: 'Approver comments']
  action_date date [not null]
  created_at timestamptz [default: `now()`]
}

Table payroll.tax_brackets_eth {
  bracket_id int [pk, increment]
  min_income decimal(12,2) [not null, note: 'Lower income bound (ETB)']
  max_income decimal(12,2) [note: 'Upper bound - NULL means unlimited']
  tax_rate decimal(5,4) [not null, note: 'Rate as decimal, e.g. 0.15 = 15%']
  deductible_fee decimal(12,2) [note: 'Fixed deductible amount (ETB)']
}

Table payroll.salary_matrix {
  matrix_id int [pk, increment]
  level varchar(50) [not null, note: 'Job level e.g. Junior, Senior, Lead']
  step int [not null, note: 'Step within the level']
  base_salary decimal(12,2) [not null, note: 'Monthly base salary (ETB)']
}

Table payroll.salary_contracts {
  contract_id int [pk, increment]
  employee_id int [note: 'References Employee(employee_id)']
  matrix_id int [note: 'References Salary_matrix(matrix_id)']
  contract_type varchar(30) [not null, note: 'Permanent / Fixed_Term / Probation']
  start_date date [not null, note: 'Contract effective date']
  end_date date [note: 'NULL = open-ended / permanent']
  probation_end_date date [note: 'End of probationary period']
  is_active boolean [not null, note: 'TRUE = current active contract']
  approved_by int [note: 'References Employee(employee_id)']
  signed_date date
  is_deleted boolean [default: `false`, note: 'Soft-delete']
  deleted_at timestamptz
}

Table payroll.payroll_runs {
  run_id int [pk, increment]
  run_date date [not null, note: 'Date payroll was executed']
  status varchar(20) [not null, note: 'Draft / Approved / Processed']
  run_by int [note: 'References Employee(employee_id) - payroll officer']
  approved_by int [note: 'References Employee(employee_id) - finance manager']
}

Table payroll.payslips {
  payslip_id int [pk, increment]
  employee_id int [note: 'References Employee(employee_id)']
  run_id int [note: 'References Payroll_runs(run_id)']
  gross_salary decimal(12,2) [not null, note: 'Gross pay before deductions']
  tax_amount decimal(12,2) [not null, note: 'Calculated income tax (ETB)']
  pension_amount decimal(12,2) [note: 'Employee pension contribution (ETB)']
  net_pay decimal(12,2) [not null, note: 'Final take-home pay - see 3NF deviation note']
  created_at timestamptz [default: `now()`]
}

Table payroll.employee_deductions {
  deduction_instance_id int [pk, increment]
  employee_id int [note: 'References Employee(employee_id)']
  payslip_id int [note: 'References Payslips(payslip_id)']
  type_name varchar(100) [not null, note: 'Loan_Recovery / Penalty / Advance']
  amount_deducted decimal(12,2) [not null, note: 'Amount deducted (ETB)']
  created_at timestamptz [default: `now()`]
}

Table payroll.payroll_adjustments {
  adjustment_id int [pk, increment]
  employee_id int [note: 'References Employee(employee_id)']
  run_id int [note: 'References Payroll_runs(run_id)']
  payslip_id int [note: 'References Payslips(payslip_id)']
  adjustment_type varchar(50) [not null, note: 'Bonus / Housing / Transport / Meal / Fine']
  description text
  amount decimal(12,2) [not null, note: 'Positive = addition, Negative = deduction']
  is_taxable boolean [not null, note: 'Affects taxable income-']
  payment_status varchar(20) [not null, note: 'Pending / Paid']
  created_at timestamptz [default: `now()`]
  updated_at timestamptz
}

Table payroll.leave_types {
  type_id int [pk, increment]
  name varchar(100) [not null, note: 'Annual / Sick / Maternity / Study']
  is_paid boolean [not null, note: 'TRUE = paid leave']
}

Table payroll.leave_entitlements {
  type_id int [note: 'References Leave_types(type_id)']
  job_id int [note: 'References Job_titles(job_id) - forms composite PK']
  days_per_year int [not null, note: 'Total allowed leave days per year']
  accrual_rate_monthly decimal(5,2) [note: 'Days accrued per month']
  can_carry_over boolean [not null, note: 'Can unused days roll over to next year-']

  indexes {
    (type_id, job_id) [pk]
  }
}

Table payroll.leave_requests {
  request_id int [pk, increment]
  employee_id int [note: 'References Employee(employee_id)']
  type_id int [note: 'References Leave_types(type_id)']
  start_date date [not null]
  end_date date [not null]
  status varchar(20) [not null, note: 'Pending / Approved / Rejected']
  approved_by int [note: 'References Employee(employee_id)']
  created_at timestamptz [default: `now()`]
  updated_at timestamptz
}

Table payroll.expense_claims {
  claim_id int [pk, increment]
  employee_id int [note: 'References Employee(employee_id)']
  payslip_id int [note: 'References Payslips(payslip_id) - nullable']
  amount decimal(12,2) [not null, note: 'Reimbursement amount (ETB)']
  category varchar(50) [note: 'Travel / Meals / Supplies / Other']
  description text
  receipt_path text [note: 'File path / URL to receipt']
  status varchar(20) [not null, note: 'Pending / Approved / Rejected / Paid']
  submitted_date date [not null]
  created_at timestamptz [default: `now()`]
  updated_at timestamptz
}

Table payroll.claim_approvals {
  approval_id int [pk, increment]
  claim_id int [note: 'References Expense_claims(claim_id)']
  approver_id int [note: 'References Employee(employee_id)']
  created_at timestamptz [default: `now()`]
}

Table payroll.benefit_plans {
  plan_id int [pk, increment]
  plan_name varchar(100) [not null, note: 'e.g. Standard Health, Executive Pension']
  plan_type varchar(50) [not null, note: 'Health / Pension / Life / Other']
  provider varchar(200) [note: 'Insurance or fund provider name']
  description text
  start date [note: 'Plan effective from']
  employee_contribution_rate decimal(5,4) [note: 'Portion paid by employee']
  employer_contribution_rate decimal(5,4) [note: 'Portion paid by employer']
  is_deleted boolean [default: `false`, note: 'Soft-delete']
  deleted_at timestamptz
}

Table payroll.employee_benefits {
  enrollment_id int [pk, increment]
  employee_id int [note: 'References Employee(employee_id)']
  plan_id int [note: 'References Benefit_plans(plan_id)']
  enrollment_date date [not null]
  end_date date [note: 'NULL = still enrolled']
  employee_contribution decimal(12,2) [note: 'Actual ETB contributed by employee']
  employer_contribution decimal(12,2) [note: 'Actual ETB contributed by employer']
  created_at timestamptz [default: `now()`]
  updated_at timestamptz
}

Table recruitment.job_titles {
  job_id int [pk, increment]
  title_name varchar(100) [not null, note: 'e.g. Software Engineer, HR Officer']
  exam_type varchar(50) [note: 'Type of qualification exam']
  job_row int [note: 'Grade row in salary matrix']
}

Table recruitment.vacancies {
  vacancy_id int [pk, increment]
  job_id int [note: 'References Job_titles(job_id)']
  status varchar(20) [not null, note: 'Open / Closed / Filled']
  type varchar(50) [note: 'Full_Time / Part_Time / Contract']
  no_of_positions int [note: 'Number of positions available']
  posted_date date
  closing_date date [note: 'Application deadline']
  description text [note: 'Job description']
  is_deleted boolean [default: `false`, note: 'Soft-delete']
  deleted_at timestamptz
}

Table recruitment.candidates {
  candidate_id int [pk, increment]
  f_name varchar(50) [not null]
  l_name varchar(50) [not null]
  full_name varchar(100) [note: 'Computed from f_name and l_name; generated in PostgreSQL DDL.']
  email varchar(100) [unique]
  vacancy_id int [note: 'References Vacancies(vacancy_id)']
  source varchar(50) [note: 'LinkedIn / Walk_in / Referral / Portal']
  application_date date
  cover_letter_path text [note: 'File path / URL']
  is_deleted boolean [default: `false`, note: 'Soft-delete']
  deleted_at timestamptz
  created_at timestamptz [default: `now()`]
}

Table recruitment.recruitment_results {
  result_id int [pk, increment]
  candidate_id int [note: 'References Candidates(candidate_id)']
  exam_score decimal(5,2) [note: 'Written / technical exam score']
  interview_score decimal(5,2) [note: 'Panel interview score']
  status varchar(20) [not null, note: 'Pass / Fail / Pending / Hired']
  created_at timestamptz [default: `now()`]
  updated_at timestamptz
}

Table recruitment.candidate_phones {
  phone_id int [pk, increment]
  candidate_id int [note: 'References Candidates(candidate_id)']
  phone_type varchar(30) [not null, note: 'Mobile / Home / Work / Other']
  phone_number varchar(20) [not null]
  is_primary boolean [default: `false`, note: 'Primary contact number flag']
}

Table recruitment.job_training_requirements {
  job_id int [note: 'References Job_titles(job_id)']
  training_id int [note: 'References Trainings(training_id) - composite PK']

  indexes {
    (job_id, training_id) [pk]
  }
}

Table performance.performance_plans {
  plan_id int [pk, increment]
  employee_id int [note: 'References Employee(employee_id)']
  year smallint [not null, note: 'Performance plan year']
  period_start date [not null, note: 'Plan start date']
  period_end date [not null, note: 'Plan end date']
  plan_status varchar(20) [not null, note: 'Draft / Active / Closed']
  created_by int [note: 'References Employee(employee_id)']
  created_at timestamptz [default: `now()`]
  updated_at timestamptz
}

Table performance.performance_goals {
  goal_id int [pk, increment]
  plan_id int [note: 'References Performance_plans(plan_id)']
  goal_title varchar(200) [not null, note: 'Goal title']
  description text
  target_value decimal(10,2) [note: 'Quantitative target']
  actual_value decimal(10,2) [note: 'Achieved value (filled during review)']
  weight decimal(5,2) [note: 'Percentage weight of this goal']
  status varchar(20) [not null, note: 'On_Track / Achieved / Missed']
  eval_date date
  created_at timestamptz [default: `now()`]
  updated_at timestamptz
}

Table performance.performance_review {
  review_id int [pk, increment]
  plan_id int [note: 'References Performance_plans(plan_id)']
  reviewer_id int [note: 'References Employee(employee_id)']
  review_date date [not null]
  reality_score decimal(5,2) [note: 'Actual achieved score']
  overall_rating decimal(4,2) [note: 'Aggregate performance rating']
  approval_status varchar(20) [not null, note: 'Pending / Approved / Rejected']
  comments text [note: 'Reviewer qualitative notes']
  created_at timestamptz [default: `now()`]
  updated_at timestamptz
}

Table training.trainings {
  training_id int [pk, increment]
  employee_id int [note: 'References Employee(employee_id)']
  title varchar(200) [not null, note: 'Course / program title']
  type varchar(50) [note: 'Internal / External / Online']
  provider varchar(200) [note: 'Training institution / platform']
  start_date date
  end_date date
  cost decimal(10,2) [note: 'Cost in ETB']
  location varchar(100) [note: 'Venue or URL']
  status varchar(20) [not null, note: 'Planned / Ongoing / Completed']
  created_at timestamptz [default: `now()`]
  updated_at timestamptz
}

Table training.training_evaluations {
  eval_id int [pk, increment]
  training_id int [note: 'References Trainings(training_id)']
  score decimal(5,2) [note: 'Post-training assessment score']
  certificate_issued boolean [default: `false`, note: 'Certificate granted-']
  certificate_expiry date [note: 'Certificate validity end date']
  evaluated_by int [note: 'References Employee(employee_id)']
  created_at timestamptz [default: `now()`]
  updated_at timestamptz
}

Table auth.user_accounts {
  user_id int [pk, increment]
  employee_id int [unique, note: 'References Employee(employee_id)']
  username varchar(50) [not null, unique, note: 'Login identifier']
  password_hash varchar(255) [not null, note: 'Hashed password (bcrypt / argon2)']
  last_login timestamptz [note: 'Most recent successful login']
  is_active boolean [default: `true`, note: 'Account enabled / disabled']
  created_at timestamptz [default: `now()`]
  is_deleted boolean [default: `false`, note: 'Soft-delete']
  deleted_at timestamptz
}

Table auth.roles {
  role_id int [pk, increment]
  role_name varchar(100) [not null, unique, note: 'Admin / HR_Manager / Finance / Employee']
}

Table auth.role_permissions {
  permission_id int [pk, increment]
  role_id int [note: 'References Roles(role_id)']
  permission_name varchar(100) [not null, note: 'e.g. view_payroll, edit_employee, approve_leave']
}

Table auth.audit_logs {
  log_id int [pk, increment, note: 'Append-only - never updated or deleted']
  user_id int [note: 'References User_accounts(user_id)']
  action_type varchar(20) [not null, note: 'INSERT / UPDATE / DELETE']
  table_name varchar(100) [not null, note: 'The affected table']
  record_id int [not null, note: 'PK value of the affected row']
  old_value jsonb [note: 'Before-state snapshot']
  new_value jsonb [note: 'After-state snapshot']
  ip_address varchar(45) [note: 'Requester IP (IPv4 / IPv6)']
  timestamp timestamptz [default: `now()`, note: 'When the change occurred']
}

Table auth.user_roles {
  user_id int [note: 'References User_accounts(user_id)']
  role_id int [note: 'References Roles(role_id) - composite PK']

  indexes {
    (user_id, role_id) [pk]
  }
}

Table shared.documents {
  document_id int [pk, increment]
  entity_type varchar(50) [not null, note: 'Employee / Payslip / Candidate / Training / Contract']
  entity_id int [not null, note: 'PK of the referenced record - no hard FK (polymorphic design)']
  file_name varchar(255) [not null, note: 'Original filename']
  file_path text [not null, note: 'Storage path or CDN URL']
  file_type varchar(50) [note: 'PDF / JPEG / DOCX / PNG']
  description text [note: 'Brief document description']
  uploaded_by int [note: 'References Employee(employee_id)']
  upload_date date [not null]
  created_at timestamptz [default: `now()`]
}

Ref: org.employee.dept_id > org.departments.dept_id
Ref: org.employee.job_id > recruitment.job_titles.job_id
Ref: org.employee.office_id > org.offices.office_id
